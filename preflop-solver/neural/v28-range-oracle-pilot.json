  "sealedConfirmationCache": "neural/runs/v28-overnight/cache-h.json.gz",
  "inputs": {
    "observable": [
      "hero exact hole cards",
      "exact flop",
      "public preflop history",
      "public pot and remaining stacks",
      "hero exact 169-class hand",
      "production 64-feature board texture",
      "hero public 169-class range",
      "opponent hero-blocked 169-class range"
    ],
    "targetOnly": [
      "opponent exact hole cards",
      "turn",
      "river"
    ],
    "rangeTransform": "square_root_of_normalized_probability",
