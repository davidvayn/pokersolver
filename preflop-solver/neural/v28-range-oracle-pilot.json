    "seeds": [9901, 9902]
  },
  "network": {
    "hiddenSizes": [128, 64],
    "architecture": "range_tower",
    "activation": "relu",
    "optimizer": "adamw",
    "learningRate": 0.0003,
    "weightDecay": 0.001,
    "steps": 2000,
    "batchSize": 2048,
    "loss": "mse",
    "boundedOutput": true
  },
  "freezeBeforeHoldout": {
    "minimumGroupedRmseRelativeImprovement": -0.05,
    "interpretation": "range representation must be within five percent of the otherwise identical no-range control",
    "rangeMustWinBothSeeds": false,
    "minimumCrossSeedPredictionCorrelation": 0.95,
