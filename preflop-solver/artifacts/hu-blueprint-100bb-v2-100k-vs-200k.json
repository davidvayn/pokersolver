    "maximum_held_out_unknown_information_set_fraction": 0.05,
    "maximum_held_out_untrained_information_set_fraction": 0.025,
    "maximum_aggregate_action_frequency_delta": 0.03,
    "maximum_per_action_mae": 0.08,
