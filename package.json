{
  "name": "pokersolver",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "predev": "npm run build:solver",
    "build": "npm run build:solver && next build",
    "build:solver": "cargo build --release --manifest-path preflop-solver/Cargo.toml",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflop:catalog": "node scripts/generate-preflop-catalog.mjs",
    "preflop:compare-blueprints": "node scripts/compare-blueprint-artifacts.mjs",
    "test:blueprint-compare": "node --test scripts/compare-blueprint-artifacts.test.mjs",
    "policy:export": "node scripts/policy/export-shards.mjs",
    "policy:export-neural": "node scripts/policy/export-neural-artifact.mjs",
    "policy:compose-neural": "node scripts/policy/export-neural-artifact.mjs",
    "policy:import": "node scripts/policy/import-dynamo.mjs",
    "policy:verify": "node scripts/policy/verify-dynamo.mjs",
    "policy:activate": "node scripts/policy/activate-or-rollback.mjs",
    "policy:size": "node scripts/policy/audit-size.mjs",
    "policy:validate-seeds": "node scripts/policy/validate-full-hand-seeds.mjs",
    "test:policy-tools": "node --test scripts/policy/*.test.mjs",
    "test:neural-trainer": "preflop-solver/.venv-neural/bin/python -m unittest discover -s preflop-solver/neural -p 'test_*.py'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.1",
    "lucide-react": "^1.26.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
